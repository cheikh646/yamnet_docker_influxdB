FROM arm64v8/python:3.9-slim

LABEL maintainer="henning.agt@gmail.com"

# 1. Installation des dépendances système
# Ajout de build-essential pour permettre la compilation de certains packages python si nécessaire
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    ffmpeg \
    curl \
    git \
    pkg-config \
    libhdf5-dev \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. Mise à jour de pip et outils de build
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 3. Installation de TensorFlow et H5PY (Ordre critique)
# On installe h5py avec les libs système déjà présentes
RUN pip install --no-cache-dir h5py
# Utilisation de tensorflow standard (les versions récentes Wheels supportent bien l'ARM64 nativement)
RUN pip install --no-cache-dir tensorflow==2.13.0

# 4. Installation des dépendances de ton script
RUN pip install --no-cache-dir \
    influxdb-client \
    resampy \
    soundfile \
    numpy==1.24.3 

# 5. Gestion de YAMNet (Plus propre)
# On clone uniquement le dossier nécessaire pour gagner du temps et de l'espace
RUN git clone --depth 1 https://github.com/tensorflow/models.git /tmp/models \
    && mv /tmp/models/research/audioset/yamnet/ /yamnet/ \
    && rm -rf /tmp/models

WORKDIR /yamnet

# 6. Copie de ton script et des fichiers nécessaires
# Assure-toi que yamnet_class_map.csv et yamnet.h5 sont dans ton dossier local
COPY yamnet_processing.py .
COPY requirements_yamnet.txt .

# On installe le reste, mais attention à ce que requirements_yamnet.txt 
# ne contienne PAS 'tensorflow', sinon il va tout casser.
RUN pip install --no-cache-dir -r requirements_yamnet.txt

ENTRYPOINT ["python3", "yamnet_processing.py"]

